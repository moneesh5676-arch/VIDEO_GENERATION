# ---- MONEESH AI STUDIO backend settings ----
# Copy this file to ".env" and edit the values. NEVER share or commit your .env file.

# Origins allowed to call this API (your React app). Separate several with commas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Max size of an uploaded reference image, in megabytes.
MAX_UPLOAD_MB=10

# ---- AI video provider (needed for REAL video generation) ----
# "none" = no provider. The API still runs, but every generation will fail with a clear message.
# Real providers (Replicate, fal.ai, ...) are added in the next stage.
VIDEO_PROVIDER=none
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_MODEL=
