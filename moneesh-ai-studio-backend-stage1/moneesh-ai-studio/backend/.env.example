# ---- MONEESH AI STUDIO backend settings ----
# Copy this file to ".env" and edit the values. NEVER share or commit your .env file.

# Origins allowed to call this API (your React app). Separate several with commas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Max size of an uploaded reference image, in megabytes.
MAX_UPLOAD_MB=10

# ---- AI provider (required for image/video generation) ----
# Create an API key in your fal.ai account, then set VIDEO_PROVIDER=fal and paste it here.
# Never commit the backend ".env" file or expose the key in frontend code.
VIDEO_PROVIDER=none
VIDEO_PROVIDER_API_KEY=
VIDEO_PROVIDER_MODEL=fal-ai/kling-video/v3/standard/text-to-video
VIDEO_PROVIDER_IMAGE_MODEL=fal-ai/kling-video/v3/pro/image-to-video
VIDEO_PROVIDER_TEXT_IMAGE_MODEL=fal-ai/flux-2-pro
